{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationDir": "./dist/types",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true
  },
  "include": ["src/types/**/*.d.ts", "src/**/*.ts"],
  "exclude": ["node_modules", "dist", "test"]
}
